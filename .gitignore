node_modules/
.env
.env.*
# Operator secrets for a real deployment. The runbook tells you to create
# `prod.env` at the repo root, and neither rule above matches that name, so it
# gets its own: a single `git add .` would otherwise publish STARDRIVE_SECRET,
# the model key and the Stripe keys in one commit.
*.env
dist/
out/
.DS_Store

# Runtime state of the API service (keys, usage, jobs, workspaces) — never committed.
services/api/var/

# Failing test output, written by test/run-all.mjs.
services/api/test-logs/
